# Переменные окружения для MCP сервера синтаксис-помощника 1С

# Elasticsearch. localhost годится, когда сервер запущен вне контейнера.
# В compose-контуре хост задан в docker-compose.yml именем сервиса
# (elasticsearch), и правки .env туда не попадают — см. docs/CONFIGURATION.md.
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=help1c_docs
ELASTICSEARCH_TIMEOUT=30
ELASTICSEARCH_MAX_RETRIES=3

# MCP сервер настройки
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# CORS: список источников через запятую, "*" — разрешить все.
CORS_ALLOW_ORIGINS=*

# Пути к данным
HBK_DIRECTORY=./data/hbk
LOGS_DIRECTORY=./data/logs

# Имя книги справки для индексации. В каталоге могут лежать и другие .hbk.
HBK_FILENAME=shcntx_ru.hbk

# Английская справка (необязательно). Файл shcntx_root.hbk лежит рядом с
# русским в каталоге bin установленной платформы.
HBK_DIRECTORY_EN=data/hbk-en
HBK_FILENAME_EN=shcntx_root.hbk
ELASTICSEARCH_INDEX_EN=help1c_docs_en

# Язык ответа по умолчанию: ru или en. Переопределяется параметром lang.
DEFAULT_HELP_LANG=ru

# Настройки индексации
REINDEX_ON_STARTUP=false  # true - переиндексировать при каждом запуске, false - только если индекс пуст
